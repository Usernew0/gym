{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User account profiles, authentication data, and credentials",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "company": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["userId", "username", "role", "status"]
    },
    "workout_sheets": {
      "title": "Workout Programs and Sheets",
      "description": "Workout programs, extracted splits, multi-week schedules and exercises",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "totalWeeks": { "type": "number" },
        "currentWeek": { "type": "number" },
        "splitType": { "type": "string" },
        "daysCount": { "type": "number" },
        "rawSheetText": { "type": "string" },
        "exercises": { "type": "array" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "workout_logs": {
      "title": "Workout Session Logs",
      "description": "Daily workout logs, lifted weights, repetitions, completed sets, and volume",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sheetId": { "type": "string" },
        "sheetName": { "type": "string" },
        "userId": { "type": "string" },
        "dayName": { "type": "string" },
        "weekNumber": { "type": "number" },
        "date": { "type": "string" },
        "totalVolumeKg": { "type": "number" },
        "maxWeightKg": { "type": "number" },
        "exercises": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "dayName"]
    },
    "nutrition_logs": {
      "title": "Nutrition & Meal Logs",
      "description": "Daily nutrition records, calories, protein, carbs, fats, and water consumption",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "targetCalories": { "type": "number" },
        "consumedCalories": { "type": "number" },
        "proteinGrams": { "type": "number" },
        "targetProteinGrams": { "type": "number" },
        "carbsGrams": { "type": "number" },
        "fatsGrams": { "type": "number" },
        "waterMl": { "type": "number" },
        "meals": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "date"]
    },
    "calculations": {
      "title": "Saved Calculations",
      "description": "Cargo profit and exchange rate calculation records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "currencyPair": { "type": "string" },
        "buyRate": { "type": "number" },
        "sellRate": { "type": "number" },
        "amount": { "type": "number" },
        "profit": { "type": "number" },
        "cargoType": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "currencyPair", "amount", "profit"]
    },
    "site_settings": {
      "title": "Site Settings & Security Policy",
      "description": "Global application settings including favicon branding and session inactivity timeout",
      "type": "object",
      "properties": {
        "faviconUrl": { "type": "string" },
        "inactivityTimeoutMinutes": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    }
  }
}
